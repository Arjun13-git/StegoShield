# StegoShield API configuration. All values are optional; the defaults are shown.
# The app does not load this file itself: export the variables, or start uvicorn with
#   uvicorn app.main:app --env-file .env
# Relative paths are resolved against the repository root, not the working directory.

# --- upload / image limits ---
MAX_UPLOAD_BYTES=10485760
MIN_IMAGE_SIDE=64
MAX_IMAGE_SIDE=4096
# Pixel cap (feature extraction needs ~55-60 bytes of RAM per pixel; 4 MP = 2048x2048)
MAX_IMAGE_PIXELS=4194304
MAX_MESSAGE_BYTES=16384
MAX_CONCURRENT_ANALYSES=2

# --- model (local artifact; never committed, never uploaded through the API) ---
MODEL_PATH=data/models/stegoshield_rf.joblib
# Pinned SHA-256 of the frozen artifact is built in. Set to override; set to an EMPTY value to
# disable the integrity check (weakens protection against a tampered pickle-based artifact).
# MODEL_SHA256=
REFERENCE_PATH=backend/app/resources/reference_scores_v1.json

# --- http ---
# Comma-separated explicit origins (the Next.js dev server on port 3000); "*" is rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to false to disable /docs, /redoc and /openapi.json
ENABLE_DOCS=true
